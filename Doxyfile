# FunDEMBeta API reference configuration.
PROJECT_NAME           = "FunDEMBeta"
PROJECT_NUMBER         = 1.0.2
PROJECT_BRIEF          = "Unified CPU/CUDA DEM and SPH-DEM framework"

OUTPUT_DIRECTORY       = docs/api
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = ./README.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_STATIC         = YES
TYPEDEF_HIDES_STRUCT   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES

INPUT                  = README.md \
                         README_macOS.md \
                         docs \
                         math \
                         data \
                         material \
                         geometry \
                         particle \
                         interaction \
                         execution \
                         solver \
                         cmake \
                         tests \
                         tutorial \
                         validation \
                         example
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cuh *.cpp *.cu *.md
EXTENSION_MAPPING      = cu=C++ cuh=C++
# Filters affect documentation parsing only; source listings remain unchanged.
FILTER_PATTERNS        = *.md="python3 docs/doxygenMarkdown.py" \
                         *.h="python3 docs/doxygenCpp.py" \
                         *.cuh="python3 docs/doxygenCpp.py" \
                         *.cpp="python3 docs/doxygenCpp.py" \
                         *.cu="python3 docs/doxygenCpp.py"
FILTER_SOURCE_FILES    = NO
RECURSIVE              = YES
EXCLUDE                = docs/api
EXCLUDE_PATTERNS       = */build/* */build-*/*
EXAMPLE_PATH           = tutorial
IMAGE_PATH             = docs/assets
HTML_EXTRA_FILES       = docs/assets/tutorial0.mp4

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           =

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 80
HTML_COLORSTYLE_GAMMA  = 90
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_DOCBOOK       = NO

HAVE_DOT               = NO
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
